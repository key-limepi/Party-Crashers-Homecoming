# copy this file to .env and fill it in

# formbar server (the one players log in with and pay digipogs on)
FORMBAR_ADDRESS=https://formbar.yorktechapps.com
# where the formbar login page lives (defaults to FORMBAR_ADDRESS)
# FORMBAR_CLIENT_URL=https://formbar.yorktechapps.com

# public address of this game, formbar sends players back here after login
URL=http://localhost:8000
# PORT=8000

# the digipog pool that receives every payment
POOL_ID=0

# digipog costs
ROUND_COST=25
MALICE_PRICE=10

# malice
MALICE_PER_ROUND=1
MALICE_PER_BUY=1
